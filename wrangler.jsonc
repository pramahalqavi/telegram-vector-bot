{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vector-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "kv_namespaces": [
    {
      "binding": "DRAFTS_KV",
      "id": "613957fa55724dd4bf4c311683783764"
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "glance-book-summary",
    "GEMINI_MODEL": "gemini-3.8-flash"
  }
}
